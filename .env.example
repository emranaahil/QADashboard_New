# Development
NODE_ENV=development
PORT=3000
WEB_APP_URL=http://localhost:3001

# Production (Render / Docker)
# PORT=10000          # public Next.js UI port
# API_PORT=3000       # internal Express API port
# API_URL=http://127.0.0.1:3000

# Playwright (Docker / Render — browsers pre-installed in image)
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=true
PLAYWRIGHT_CHROMIUM_SANDBOX=false

# Persistent data (Render disk / Docker volume mount)
STORAGE_ROOT=/app/data

# Job queue — cancel stale jobs on deploy restart (recommended for production)
JOB_RECOVER_ON_STARTUP=false

# Google PageSpeed Insights API (SEO audit — optional)
# PAGESPEED_API_KEY=your_google_cloud_api_key
# PAGESPEED_TIMEOUT_MS=180000
# PAGESPEED_RETRY_COUNT=2

# Security Audit — W3C Nu HTML checker User-Agent (required by validator.w3.org)
# W3C_VALIDATOR_USER_AGENT=QA-Dashboard-SecurityAudit/1.0 (contact: support@example.com)
# W3C_VALIDATOR_TIMEOUT_MS=45000
# W3C_VALIDATOR_MAX_ISSUES=200

# SSL Labs API (Security Audit — optional TLS grade check via api.ssllabs.com)
# SSL_LABS_USER_AGENT=QA-Dashboard-SecurityAudit/1.0 (+node)
# SSL_LABS_MAX_POLL_ATTEMPTS=90
# SSL_LABS_MAX_WAIT_MS=360000
# SSL_LABS_CACHE_MAX_AGE_HOURS=24